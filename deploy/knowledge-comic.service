[Unit]
Description=Knowledge Comic Generator (Streamlit)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/knowledge-comic
EnvironmentFile=/opt/knowledge-comic/.env
ExecStart=/opt/knowledge-comic/venv/bin/python -m streamlit run app.py --server.port 8550 --server.headless true --server.address 0.0.0.0
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
