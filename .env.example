# 知识漫画生成器 — 环境变量配置
# 复制为 .env 后修改

# ── 大模型 API ──
DASHSCOPE_API_KEY=sk-your-key-here

# ── ComfyUI 地址 ──
# 本地开发：http://127.0.0.1:8188
# 云端部署（frp 隧道映射）：http://127.0.0.1:8188
COMFYUI_URL=http://127.0.0.1:8188

# ── Streamlit ──
STREAMLIT_PORT=8550

# ── Admin 后台密码（为空则不需要密码） ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-admin-password

# ── 微信关注限制（true/false） ──
# 开启后用户需输入使用码才能使用生成功能
REQUIRE_WECHAT_FOLLOW=false
WECHAT_FOLLOW_GUIDE=请关注公众号「XXX」，发送"激活"获取使用码
